{
  "name": "demo-shelf-LAB",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "npm run dev -w server & npm run dev -w web",
    "start": "npm start -w server",
    "test": "npm test -w server && npm test -w web",
    "build": "npm run build -w web",
    "doctor": "node scripts/doctor.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "e2e": "node scripts/e2e.mjs",
    "e2e:refresh-docs": "node scripts/e2e.mjs --refresh-docs",
    "agent": "node server/src/agent-cli.js",
    "docker": "node scripts/docker-up.mjs up",
    "docker:down": "node scripts/docker-up.mjs down"
  },
  "devDependencies": {
    "playwright": "^1.58.2"
  },
  "version": "1.0.0",
  "license": "MIT",
  "description": "A local launcher: every Ping demo on your machine, with a status light for each."
}
