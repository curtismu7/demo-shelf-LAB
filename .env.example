# All optional. The shelf has no accounts and holds no secrets or tokens.

# Port the shelf listens on (4400+ keeps clear of the demos' own ports).
SHELF_PORT=4400

# Address to listen on. Unset = 127.0.0.1 (loopback only). Any other address is refused
# unless you set it here on purpose.
# SHELF_BIND=127.0.0.1

# Hosts, besides localhost / 127.0.0.1 / ::1, that a registered demo URL may point at.
# SHELF_ALLOWED_HOSTS=my-mac.local

# Set to 1 to show Start / Stop. Runs `docker compose -f <registered file> up -d` / `down`,
# and only when `docker context show` says orbstack.
# SHELF_ALLOW_START=1

# Where user overrides live (demos.local.json). Default: ./.data
# SHELF_DATA_DIR=.data

# Replace the committed seed registry (data/demos.json) with another file. Used by the e2e script.
# SHELF_SEED_FILE=/absolute/path/demos.json
